# notification/.env -- key template for the Dashboard & Notification Layer.
#
# Copy to notification/.env and fill every value. The real file is gitignored and
# must never be committed or printed. Keys marked SECRET hold credentials.
#
# Consumed by src/notifications/{alert_dispatcher,notify_line,notify_gmail}.py via
# config_utils.looks_real(), which rejects anything shorter than 10 characters or
# containing "changeme" / "placeholder" / "your_" / "xxxxx" / "todo". So a value left
# as a placeholder below does not half-work: that channel falls back to dry-run and
# logs why. Failing closed is deliberate.
#
# The *_DOCKER_* variants are the same services addressed from inside a container
# (service name or host.docker.internal) rather than from the host.
# notification/grafana.env.example covers only the GF_* subset that grafana/docker-compose.yml
# reads; this file is the full set.

# ---------------------------------------------------------------- Kafka: none needed
# Seven KAFKA_* keys used to sit here, described as "the dispatcher consumes LLM output
# here". That was never true of the code. alert_dispatcher.py has no KafkaConsumer; it is
# a library that src/pipeline.py calls in process, and `grep KAFKA_ src/notifications/`
# returns nothing. The keys were removed on 2026-11-08 because configuration that
# describes a component nobody built is worse than no configuration: it is what a reader
# trusts instead of reading the code, and it had already been cited as evidence that a
# consumer existed.
#
# If a Kafka-consuming dispatcher is ever built, add the keys back together with the code
# that reads them, not before. The enrichment service has its own Kafka settings in the
# repo-root .env, which are separate from this file.

# ---------------------------------------------------------------- LINE (HIGH priority)
# Messaging API channel. LINE_CHANNEL_ACCESS_TOKEN comes from the LINE Developers console,
# Messaging API tab -> "Channel access token (long-lived)" -> Issue.
#
# LINE_DELIVERY_MODE picks the endpoint, and the two are not interchangeable:
#
#   broadcast  /v2/bot/message/broadcast -- goes to everyone who has added the bot as a
#              friend. Needs NO recipient id, so analysts subscribe by adding the bot and
#              nobody maintains a roster. Two costs: 60 requests per hour per channel, so a
#              burst of HIGH alerts above one per minute is rate-limited (HTTP 429); and no
#              routing at all -- every friend gets every alert, so HIGH-to-on-call is not
#              expressible. Suits a lab or a demo, not a production alerting path.
#
#   push       /v2/bot/message/push -- one named destination, 2,000 requests/s, and the
#              only mode that can route. Requires LINE_TO_ID.
#
# An unrecognised value falls back to push, deliberately: a typo must not be what decides
# to message every friend of the channel.
#
# LINE_TO_ID is required by push only. It cannot be obtained programmatically:
# /v2/bot/followers/ids returns HTTP 403 without a verified or premium Official Account,
# and a group/room id (C.../R...) only arrives on a webhook event this project does not
# run. Copy "Your user ID" (33 characters, starts with U) from the console's Basic
# settings tab, and add the bot as a friend from that account -- a push to a non-friend is
# rejected. Note the console shows the BOT's own userId nearby; pushing to that fails.
#
# Verify either mode without sending anything:
#   uv run python -m src.notifications.line_preflight
LINE_CHANNEL_ACCESS_TOKEN=            # SECRET
LINE_DELIVERY_MODE=broadcast
LINE_TO_ID=                           # push mode only; leave empty for broadcast
LINE_GRAFANA_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- Gmail (MEDIUM / LOW digest)
# OAuth2 installed-app credentials for the gmail.send scope only. To obtain them:
#   1. Google Cloud console -> enable the Gmail API on a project.
#   2. OAuth consent screen -> External, add your own address as a test user.
#   3. Credentials -> Create credentials -> OAuth client ID -> Desktop app.
#      That gives GMAIL_CLIENT_ID and GMAIL_CLIENT_SECRET.
#   4. Mint the refresh token on a machine with a browser and outbound internet:
#        uv run python -m src.notifications.gmail_oauth_setup --write
#      It opens a consent window and writes GMAIL_REFRESH_TOKEN into notification/.env.
# GMAIL_SENDER_ADDRESS must be the account that granted consent in step 4; Gmail rejects
# a From: address the token does not own.
GMAIL_CLIENT_ID=                      # SECRET
GMAIL_CLIENT_SECRET=                  # SECRET
GMAIL_REFRESH_TOKEN=                  # SECRET
GMAIL_SENDER_ADDRESS=
# Cron expression (host timezone) for the LOW-priority daily digest.
LOW_DIGEST_SCHEDULE=0 18 * * *

# ---------------------------------------------------------------- RabbitMQ event bus
# Reuses the live opencti-rabbitmq broker on its own `soc` vhost, so SOC traffic never
# shares a vhost with OpenCTI's own queues. Both URLs embed credentials -> SECRET.
RABBITMQ_URL=                         # SECRET  amqp://user:pass@localhost:5672/soc
RABBITMQ_DOCKER_URL=                  # SECRET  amqp://user:pass@opencti-rabbitmq:5672/soc
RABBITMQ_VHOST=soc
RABBITMQ_EXCHANGE=soc.alerts

# ---------------------------------------------------------------- InfluxDB (Grafana metrics)
# INFLUX_TOKEN needs write access to INFLUX_BUCKET. The three DOCKER_INFLUXDB_INIT_*
# bootstrap keys live in observability/.env, not here.
INFLUX_URL=http://localhost:8086
INFLUX_DOCKER_URL=http://host.docker.internal:8086
INFLUX_TOKEN=                         # SECRET
INFLUX_ORG=soc
INFLUX_BUCKET=alerts

# ---------------------------------------------------------------- Elasticsearch (Kibana drill-down)
# Two keys on purpose: the dispatcher writes with ELASTIC_API_KEY, Grafana's datasource
# reads with ELASTIC_READER_API_KEY, so a dashboard credential cannot modify alert history.
ELASTIC_URL=http://localhost:9200
ELASTIC_DOCKER_URL=http://host.docker.internal:9200
ELASTIC_API_KEY=                      # SECRET  write
ELASTIC_READER_API_KEY=               # SECRET  read-only
ELASTIC_ALERT_INDEX=soc-alerts-*

# ---------------------------------------------------------------- Grafana
# Compose has no vendor-default fallback: it fails closed until both are set, and the
# password must be unique rather than the vendor default. Compose interpolation does not
# rotate an already-initialized Grafana database -- change it in the UI or reset the volume.
GRAFANA_URL=http://localhost:3000
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=           # SECRET
